# Dataset and results: large, and they can be regenerated
/data/
/experiments/
/experiments_smoke/
/models/
/plots/
/outputs/
*.pkl
*.pt
*.pth
*.joblib

# Videos and other big media (the slides and the written documents are kept)
*.mp4
*.avi
*.mov
*.mkv

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Virtual environments (build.sh creates sdr-env/)
sdr-env/
.venv/
venv/

# Logs of the smoke runs (the logs of the full runs in docs/logs are kept)
docs/logs/smoke_*/

# LaTeX build files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
!docs/logs/*.log

# Paper and notes stay local; the only note that is shared is howToRun.md
docs/manuscript/*
docs/notes/*
!docs/notes/howToRun.md

# The logs of the full runs are kept for now (remove the "#" to leave them out, for example
# while testing on a VM)
# docs/logs/*

# Editor and system files
.DS_Store
Thumbs.db
.idea/
.vscode/
